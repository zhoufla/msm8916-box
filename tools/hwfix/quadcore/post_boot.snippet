# --- SP970 quad-core hotfix BEGIN (inserted right after shebang) ---
# 原厂内核 per_cpu(idle_threads,1..3) 为 NULL，cpu_up() 返回 -ENOMEM，
# 导致 CPU1/2/3 永远 offline。下面把 0xc08345ec 改成 beq 跳 trampoline，
# 由 trampoline 调 fork_idle() 补建 idle 线程，再把 1..3 核拉起来。
# 撤销：执行 tools/hwfix/quadcore/unpersist.sh
SP=/system/etc/sp970_hotfix
if [ -f "$SP/trampoline.bin" ] && [ -f "$SP/patch_45ec.bin" ]; then
    dd if=$SP/trampoline.bin of=/dev/mem bs=4 seek=539020608 count=11 conv=notrunc 2>/dev/null
    dd if=$SP/patch_45ec.bin  of=/dev/mem bs=4 seek=539021691 count=1  conv=notrunc 2>/dev/null
    for c in 1 2 3; do
        echo 1 > /sys/devices/system/cpu/cpu$c/online 2>/dev/null
    done
fi
# --- SP970 quad-core hotfix END ---
