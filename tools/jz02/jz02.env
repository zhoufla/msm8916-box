# JZ02 适配参数（供脚本 / 文档引用，非设备侧文件）
# 本机 JZ02 走 5039 adb server，SP970 走默认 5037，互不干扰
JZ02_SERIAL="0"
JZ02_ADB_SERVER="tcp:5039"
JZ02_ADB_WIN="F:\\wifi\\sp970\\adb\\platform-tools\\adb.exe"
JZ02_ADB_WSL="/mnt/f/wifi/sp970/adb/platform-tools/adb.exe"
JZ02_WEB_PORT=8080
JZ02_HELPER_PORT=8899
JZ02_TOKEN="jz02-relay-2026"
# 原厂网络 adb 默认关闭，1=在开机片段里固化 service.adb.tcp.port 5555
JZ02_ENABLE_NET_ADB=1
# 离线 JZ02 开机脚本（dry-run 用）
JZ02_OFFLINE_POST_BOOT_WIN="F:\\wifi\\jz02\\BAK-analysis\\work\\system_root\\etc\\init.qcom.post_boot.sh"
JZ02_OFFLINE_POST_BOOT_WSL="/mnt/f/wifi/jz02/BAK-analysis/work/system_root/etc/init.qcom.post_boot.sh"
# v5 全量包（实机验证通过；v3/v4 的 ro.secure=0 在本机 adbd 上无效）
JZ02_FULLBIN="F:\\wifi\\jz02\\BAK-modified\\ja02-fullbak-hardened-rooted-aboot-v5.bin"
JZ02_FULLBIN_MD5="2a6e9cfcc093f1691e57918e9fda0c09"
